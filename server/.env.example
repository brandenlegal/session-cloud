# --- Database: pick ONE (uncomment and fill) ---

# Supabase — direct connection (good for Prisma migrate from many networks)
# Supabase UI: Project Settings → Database → Connection string (URI)
# If you see "Not IPv4 compatible", use Session pooler (see next line) or Supabase IPv4 add-on.
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.tujtjbbbywhvmcukhntc.supabase.co:5432/postgres"

# Supabase — Session pooler (use on IPv4-only networks when direct host is blocked)
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
# (Copy the exact pooler URL from the Supabase dashboard; region/host differ per project.)

# Railway — Postgres service → Variables → DATABASE_URL
# DATABASE_URL="your-railway-postgres-url-here"

# Local Postgres (optional)
# DATABASE_URL="postgresql://user:password@localhost:5432/sessioncloud"

PORT=5000
# Production: NODE_ENV=production (enables Helmet, trust proxy, stricter API errors)
# NODE_ENV=production

# Optional: absolute base URL for share links in API responses (e.g. https://yourapp.com)
# PUBLIC_SHARE_BASE_URL=https://yourapp.com

# Comma-separated browser origins allowed by CORS
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN=7d

# Local file storage (relative to server/ working directory)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=104857600
