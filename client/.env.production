# Production build — copy to .env.production before `npm run build`
# API origin (no trailing slash). Same host as the app if the API is reverse-proxied under /api.
VITE_API_URL=https://vault.brandensolutions.cc

# Optional: public site URL for share links / QR in emails (defaults to window.location.origin)
# VITE_PUBLIC_APP_URL=https://vault.brandensolutions.cc
